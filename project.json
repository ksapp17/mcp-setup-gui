      "tools": [
        {
          "name": "get_current_weather",
          "description": "Current weather for a city. Use when the user asks what the weather is like right now.",
          "method": "GET",
          "path": "/weather",
          "paramLocations": {
            "q": "query",
            "units": "query"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "q": {
                "type": "string",
                "description": "City name, optionally with country code, e.g. Boise,US"
              },
              "units": {
                "type": "string",
                "enum": [
                  "imperial",
                  "metric"
                ],
                "description": "imperial for °F, metric for °C. Use imperial unless the user asks for metric."
              }
            },
            "required": [
              "q",
              "units"
            ]
          },
          "annotations": {
            "readOnlyHint": true
          },
          "enabled": true
        },
        {
          "name": "get_forecast",
          "description": "5-day forecast in 3-hour steps for a city. Use for questions about upcoming weather.",
          "method": "GET",
          "path": "/forecast",
          "paramLocations": {
            "q": "query",
            "units": "query",
            "cnt": "query"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "q": {
                "type": "string",
                "description": "City, e.g. Boise,US"
              },
              "units": {
                "type": "string",
